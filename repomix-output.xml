<file path="src/lib/engine/SimulationEventBus.ts">
export interface ExtinctDetails {
	seq: number;
	reason: string;
	droppedAtIp: string;
}

type ExtinctListener = (details: ExtinctDetails) => void;

export class SimulationEventBus {
	private static instance: SimulationEventBus;
	private listeners = new Map<number, ExtinctListener[]>();

	public static getInstance(): SimulationEventBus {
		if (!SimulationEventBus.instance) {
			SimulationEventBus.instance = new SimulationEventBus();
		}
		return SimulationEventBus.instance;
	}

	public onExtinct(seq: number, callback: ExtinctListener): void {
		const current = this.listeners.get(seq) || [];
		this.listeners.set(seq, [...current, callback]);
	}

	public offExtinct(seq: number): void {
		this.listeners.delete(seq);
	}

	public emitExtinct(details: ExtinctDetails): void {
		const callbacks = this.listeners.get(details.seq);
		if (callbacks) {
			callbacks.forEach((cb) => cb(details));
			this.listeners.delete(details.seq);
		}
	}
}
